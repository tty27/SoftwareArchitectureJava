package healthcare.view;

import javax.swing.*;
import java.awt.*;
import healthcare.controller.DataController;

public class MainFrame extends JFrame {
    private DataController dataController;

    public MainFrame() {
        dataController = new DataController();
        setTitle("Healthcare Management System");
        setSize(400, 300);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLayout(new GridLayout(4, 1, 10, 10));

        JButton patientBtn = new JButton("View Patients");
        JButton clinicianBtn = new JButton("View Clinicians");
        JButton appointmentBtn = new JButton("View Appointments");
        JButton prescriptionBtn = new JButton("View Prescriptions");

        add(patientBtn);
        add(clinicianBtn);
        add(appointmentBtn);
        add(prescriptionBtn);

        patientBtn.addActionListener(e -> new PatientPanel(dataController));
        clinicianBtn.addActionListener(e -> new ClinicianPanel(dataController));
        appointmentBtn.addActionListener(e -> new AppointmentPanel(dataController));
        prescriptionBtn.addActionListener(e -> new PrescriptionPanel(dataController));

        setVisible(true);
    }
}
