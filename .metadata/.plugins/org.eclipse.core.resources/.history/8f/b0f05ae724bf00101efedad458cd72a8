package healthcare.view;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import healthcare.controller.DataController;
import healthcare.model.Appointment;

public class AppointmentPanel extends JFrame {
    public AppointmentPanel(DataController controller) {
        setTitle("Appointments");
        setSize(600, 400);
        setLayout(new BorderLayout());

        String[] columns = {"ID", "Patient ID", "Clinician ID", "Date", "Notes"};
        DefaultTableModel model = new DefaultTableModel(columns, 0);
        JTable table = new JTable(model);
        add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel bottom = new JPanel();
        JButton add = new JButton("Add");
        JButton del = new JButton("Delete");
        bottom.add(add); bottom.add(del);
        add(bottom, BorderLayout.SOUTH);

        add.addActionListener(e -> {
            JTextField id = new JTextField(), pid = new JTextField(), cid = new JTextField(), date = new JTextField(), notes = new JTextField();
            Object[] fields = {"ID:", id, "Patient ID:", pid, "Clinician ID:", cid, "Date:", date, "Notes:", notes};
            int result = JOptionPane.showConfirmDialog(this, fields, "Add Appointment", JOptionPane.OK_CANCEL_OPTION);
            if (result == JOptionPane.OK_OPTION) {
                Appointment a = new Appointment(id.getText(), pid.getText(), cid.getText(), date.getText(), notes.getText());
                controller.addAppointment(a);
                model.addRow(new Object[]{a.getId(), a.getPatientId(), a.getClinicianId(), a.getDate(), a.getNotes()});
            }
        });

        del.addActionListener(e -> {
            int row = table.getSelectedRow();
            if (row >= 0) model.removeRow(row);
        });

        setVisible(true);
    }
}
