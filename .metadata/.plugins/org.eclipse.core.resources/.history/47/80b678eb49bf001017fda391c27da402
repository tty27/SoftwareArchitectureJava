package healthcare.view;

import javax.swing.*;
import healthcare.controller.DataController;
import healthcare.model.Appointment;

public class AppointmentPanel extends BasePanel<Appointment> {
    private DataController controller;

    public AppointmentPanel(DataController controller) {
        super(new String[]{"ID", "Patient ID", "Clinician ID", "Date", "Notes"});
        this.controller = controller;

        setAddAction(e -> addAppointment());
        setEditAction(e -> editAppointment());
        setDeleteAction(e -> deleteAppointment());
    }

    private void addAppointment() {
        JTextField id = new JTextField(), pid = new JTextField(), cid = new JTextField(), date = new JTextField(), notes = new JTextField();
        Object[] fields = {"ID:", id, "Patient ID:", pid, "Clinician ID:", cid, "Date:", date, "Notes:", notes};
        if (JOptionPane.showConfirmDialog(this, fields, "Add Appointment", JOptionPane.OK_CANCEL_OPTION) == JOptionPane.OK_OPTION) {
            Appointment a = new Appointment(id.getText(), pid.getText(), cid.getText(), date.getText(), notes.getText());
            controller.addAppointment(a);
            model.addRow(new Object[]{a.getId(), a.getPatientId(), a.getClinicianId(), a.getDate(), a.getNotes()});
        }
    }

    private void editAppointment() {
        int row = getSelectedRow();
        if (row == -1) { JOptionPane.showMessageDialog(this, "Select a row first."); return; }

        JTextField id = new JTextField((String) model.getValueAt(row, 0));
        JTextField pid = new JTextField((String) model.getValueAt(row, 1));
        JTextField cid = new JTextField((String) model.getValueAt(row, 2));
        JTextField date = new JTextField((String) model.getValueAt(row, 3));
        JTextField notes = new JTextField((String) model.getValueAt(row, 4));

        Object[] fields = {"ID:", id, "Patient ID:", pid, "Clinician ID:", cid, "Date:", date, "Notes:", notes};
        if (JOptionPane.showConfirmDialog(this, fields, "Edit Appointment", JOptionPane.OK_CANCEL_OPTION) == JOptionPane.OK_OPTION) {
            model.setValueAt(id.getText(), row, 0);
            model.setValueAt(pid.getText(), row, 1);
            model.setValueAt(cid.getText(), row, 2);
            model.setValueAt(date.getText(), row, 3);
            model.setValueAt(notes.getText(), row, 4);
        }
    }

    private void deleteAppointment() {
        int row = getSelectedRow();
        if (row >= 0) removeRow(row);
    }
}
