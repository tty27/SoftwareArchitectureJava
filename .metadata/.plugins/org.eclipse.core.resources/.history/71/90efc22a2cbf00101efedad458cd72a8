package healthcare.view;

import javax.swing.*;
import java.awt.*;
import healthcare.controller.DataController;

public class MainFrame extends JFrame {
    private DataController controller;
    private JPanel contentPanel;

    public MainFrame() {
        controller = new DataController();
        setTitle("Healthcare Management System");
        setSize(900, 600);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        // Sidebar
        JPanel sidebar = new JPanel();
        sidebar.setLayout(new GridLayout(5, 1, 10, 10));
        sidebar.setBackground(new Color(42, 54, 73));
        sidebar.setBorder(BorderFactory.createEmptyBorder(20, 10, 20, 10));

        JButton patientBtn = new JButton("Patients");
        JButton clinicianBtn = new JButton("Clinicians");
        JButton appointmentBtn = new JButton("Appointments");
        JButton prescriptionBtn = new JButton("Prescriptions");
        JButton exitBtn = new JButton("Exit");

        JButton[] buttons = {patientBtn, clinicianBtn, appointmentBtn, prescriptionBtn, exitBtn};
        for (JButton b : buttons) {
            b.setBackground(new Color(85, 110, 140));
            b.setForeground(Color.WHITE);
            b.setFocusPainted(false);
            sidebar.add(b);
        }

        // Main content
        contentPanel = new JPanel(new BorderLayout());
        contentPanel.add(new JLabel("Select a module from the sidebar", SwingConstants.CENTER), BorderLayout.CENTER);

        add(sidebar, BorderLayout.WEST);
        add(contentPanel, BorderLayout.CENTER);

        // Actions
        patientBtn.addActionListener(e -> switchPanel(new PatientPanel(controller)));
        clinicianBtn.addActionListener(e -> switchPanel(new ClinicianPanel(controller)));
        appointmentBtn.addActionListener(e -> switchPanel(new AppointmentPanel(controller)));
        prescriptionBtn.addActionListener(e -> switchPanel(new PrescriptionPanel(controller)));
        exitBtn.addActionListener(e -> dispose());

        setVisible(true);
    }

    private void switchPanel(JPanel newPanel) {
        contentPanel.removeAll();
        contentPanel.add(newPanel, BorderLayout.CENTER);
        contentPanel.revalidate();
        contentPanel.repaint();
    }
}
