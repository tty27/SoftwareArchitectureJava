package healthcare.view;

import healthcare.controller.DataController;
import healthcare.model.Referral;
import healthcare.singleton.ReferralManager;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.List;

public class ReferralPanel extends JPanel {
    private JTable table;
    private DefaultTableModel tableModel;
    private DataController controller;
    private ReferralManager referralManager;

    public ReferralPanel(DataController controller) {
        this.controller = controller;
        this.referralManager = ReferralManager.getInstance();
        setLayout(new BorderLayout());

        tableModel = new DefaultTableModel(new String[]{"ID", "Patient", "Specialist", "Summary", "Urgency"}, 0);
        table = new JTable(tableModel);
        loadData();

        add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel buttonPanel = new JPanel();
        JButton addButton = new JButton("Add Referral");
        JButton deleteButton = new JButton("Delete Referral");

        addButton.addActionListener(e -> addReferral());
        deleteButton.addActionListener(e -> deleteReferral());

        buttonPanel.add(addButton);
        buttonPanel.add(deleteButton);
        add(buttonPanel, BorderLayout.SOUTH);
    }

    private void loadData() {
        tableModel.setRowCount(0);
        List<Referral> referrals = controller.getReferrals();
        for (Referral r : referrals) {
            tableModel.addRow(new Object[]{r.getId(), r.getPatientName(), r.getSpecialistName(), r.getSummary(), r.getUrgency()});
        }
    }

    private void addReferral() {
        JTextField idField = new JTextField();
        JTextField patientField = new JTextField();
        JTextField specialistField = new JTextField();
        JTextField summaryField = new JTextField();
        JTextField urgencyField = new JTextField();

        Object[] inputs = {"ID:", idField, "Patient:", patientField, "Specialist:", specialistField, "Summary:", summaryField, "Urgency:", urgencyField};
        int result = JOptionPane.showConfirmDialog(this, inputs, "Add Referral", JOptionPane.OK_CANCEL_OPTION);

        if (result == JOptionPane.OK_OPTION) {
            Referral r = new Referral(idField.getText(), patientField.getText(), specialistField.getText(), summaryField.getText(), urgencyField.getText());
            referralManager.addReferral(r);
            controller.addReferral(r);
            loadData();
        }
    }

    private void deleteReferral() {
        int selected = table.getSelectedRow();
        if (selected == -1) return;
        String id = tableModel.getValueAt(selected, 0).toString();
        controller.deleteReferral(id);
        referralManager.removeReferral(id);
        loadData();
    }
}
