package healthcare.view;

import healthcare.controller.DataController;
import healthcare.model.Facility;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.List;

public class FacilityPanel extends JPanel {
    private JTable table;
    private DefaultTableModel tableModel;
    private DataController controller;

    public FacilityPanel(DataController controller) {
        this.controller = controller;
        setLayout(new BorderLayout());

        tableModel = new DefaultTableModel(new String[]{"ID", "Name", "Type", "Contact", "Capacity"}, 0);
        table = new JTable(tableModel);
        loadData();

        add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel buttonPanel = new JPanel();
        JButton addButton = new JButton("Add");
        JButton editButton = new JButton("Edit");
        JButton deleteButton = new JButton("Delete");

        addButton.addActionListener(e -> addFacility());
        editButton.addActionListener(e -> editFacility());
        deleteButton.addActionListener(e -> deleteFacility());

        buttonPanel.add(addButton);
        buttonPanel.add(editButton);
        buttonPanel.add(deleteButton);
        add(buttonPanel, BorderLayout.SOUTH);
    }

    private void loadData() {
        tableModel.setRowCount(0);
        List<Facility> facilities = controller.getFacilities();
        for (Facility f : facilities) {
            tableModel.addRow(new Object[]{f.getId(), f.getName(), f.getType(), f.getContactInfo(), f.getCapacity()});
        }
    }

    private void addFacility() {
        JTextField idField = new JTextField();
        JTextField nameField = new JTextField();
        JTextField typeField = new JTextField();
        JTextField contactField = new JTextField();
        JTextField capacityField = new JTextField();

        Object[] inputs = {"ID:", idField, "Name:", nameField, "Type:", typeField, "Contact:", contactField, "Capacity:", capacityField};
        int result = JOptionPane.showConfirmDialog(this, inputs, "Add Facility", JOptionPane.OK_CANCEL_OPTION);

        if (result == JOptionPane.OK_OPTION) {
            Facility f = new Facility(idField.getText(), nameField.getText(), typeField.getText(), contactField.getText(), Integer.parseInt(capacityField.getText()));
            controller.addFacility(f);
            loadData();
        }
    }

    private void editFacility() {
        int selected = table.getSelectedRow();
        if (selected == -1) return;

        String id = tableModel.getValueAt(selected, 0).toString();
        String name = JOptionPane.showInputDialog("Name:", tableModel.getValueAt(selected, 1));
        String type = JOptionPane.showInputDialog("Type:", tableModel.getValueAt(selected, 2));
        String contact = JOptionPane.showInputDialog("Contact:", tableModel.getValueAt(selected, 3));
        String capacity = JOptionPane.showInputDialog("Capacity:", tableModel.getValueAt(selected, 4));

        Facility updated = new Facility(id, name, type, contact, Integer.parseInt(capacity));
        controller.updateFacility(id, updated);
        loadData();
    }

    private void deleteFacility() {
        int selected = table.getSelectedRow();
        if (selected == -1) return;
        String id = tableModel.getValueAt(selected, 0).toString();
        controller.deleteFacility(id);
        loadData();
    }
}
