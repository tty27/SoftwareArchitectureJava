package healthcare.model;

public class Patient {
    private String id;
    private String name;
    private String contact;
    private String nhsNumber;
    private String gpSurgery;

    public Patient(String id, String name, String contact, String nhsNumber, String gpSurgery) {
        this.id = id;
        this.name = name;
        this.contact = contact;
        this.nhsNumber = nhsNumber;
        this.gpSurgery = gpSurgery;
    }

    public String getId() { return id; }
    public String getName() { return name; }
    public String getContact() { return contact; }
    public String getNhsNumber() { return nhsNumber; }
    public String getGpSurgery() { return gpSurgery; }

    @Override
    public String toString() {
        return id + "," + name + "," + contact + "," + nhsNumber + "," + gpSurgery;
    }
}
