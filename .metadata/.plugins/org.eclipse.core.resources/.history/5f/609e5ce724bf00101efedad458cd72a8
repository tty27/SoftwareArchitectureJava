package healthcare.view;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import healthcare.controller.DataController;
import healthcare.model.Clinician;

public class ClinicianPanel extends JFrame {
    public ClinicianPanel(DataController controller) {
        setTitle("Clinicians");
        setSize(600, 400);
        setLayout(new BorderLayout());

        String[] columns = {"ID", "Name", "Email", "Role", "Department"};
        DefaultTableModel model = new DefaultTableModel(columns, 0);
        JTable table = new JTable(model);
        add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel bottom = new JPanel();
        JButton add = new JButton("Add");
        JButton del = new JButton("Delete");
        bottom.add(add); bottom.add(del);
        add(bottom, BorderLayout.SOUTH);

        add.addActionListener(e -> {
            JTextField id = new JTextField(), name = new JTextField(), email = new JTextField(), role = new JTextField(), dept = new JTextField();
            Object[] fields = {"ID:", id, "Name:", name, "Email:", email, "Role:", role, "Department:", dept};
            int result = JOptionPane.showConfirmDialog(this, fields, "Add Clinician", JOptionPane.OK_CANCEL_OPTION);
            if (result == JOptionPane.OK_OPTION) {
                Clinician c = new Clinician(id.getText(), name.getText(), email.getText(), role.getText(), dept.getText());
                controller.addClinician(c);
                model.addRow(new Object[]{c.getId(), c.getName(), c.getEmail(), c.getRole(), c.getDepartment()});
            }
        });

        del.addActionListener(e -> {
            int row = table.getSelectedRow();
            if (row >= 0) model.removeRow(row);
        });

        setVisible(true);
    }
}
