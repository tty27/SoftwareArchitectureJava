package healthcare.view;

import healthcare.controller.DataController;
import healthcare.model.Staff;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.List;

public class StaffPanel extends JPanel {
    private JTable table;
    private DefaultTableModel tableModel;
    private DataController controller;

    public StaffPanel(DataController controller) {
        this.controller = controller;
        setLayout(new BorderLayout());

        tableModel = new DefaultTableModel(new String[]{"ID", "Name", "Role", "Department", "Contact"}, 0);
        table = new JTable(tableModel);
        loadData();
        add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel buttonPanel = new JPanel();
        JButton addButton = new JButton("Add");
        JButton editButton = new JButton("Edit");
        JButton deleteButton = new JButton("Delete");

        addButton.addActionListener(e -> addStaff());
        editButton.addActionListener(e -> editStaff());
        deleteButton.addActionListener(e -> deleteStaff());

        buttonPanel.add(addButton);
        buttonPanel.add(editButton);
        buttonPanel.add(deleteButton);

        add(buttonPanel, BorderLayout.SOUTH);
    }

    private void loadData() {
        tableModel.setRowCount(0);
        List<Staff> staffList = controller.getStaff();
        for (Staff s : staffList) {
            tableModel.addRow(new Object[]{s.getId(), s.getName(), s.getRole(), s.getDepartment(), s.getContact()});
        }
    }

    private void addStaff() {
        JTextField idField = new JTextField();
        JTextField nameField = new JTextField();
        JTextField roleField = new JTextField();
        JTextField deptField = new JTextField();
        JTextField contactField = new JTextField();

        Object[] inputs = {"ID:", idField, "Name:", nameField, "Role:", roleField, "Department:", deptField, "Contact:", contactField};
        int result = JOptionPane.showConfirmDialog(this, inputs, "Add Staff", JOptionPane.OK_CANCEL_OPTION);

        if (result == JOptionPane.OK_OPTION) {
            Staff s = new Staff(idField.getText(), nameField.getText(), roleField.getText(), deptField.getText(), contactField.getText());
            controller.addStaff(s);
            loadData();
        }
    }

    private void editStaff() {
        int selected = table.getSelectedRow();
        if (selected == -1) return;
        String id = tableModel.getValueAt(selected, 0).toString();
        String name = JOptionPane.showInputDialog("Name:", tableModel.getValueAt(selected, 1));
        String role = JOptionPane.showInputDialog("Role:", tableModel.getValueAt(selected, 2));
        String dept = JOptionPane.showInputDialog("Department:", tableModel.getValueAt(selected, 3));
        String contact = JOptionPane.showInputDialog("Contact:", tableModel.getValueAt(selected, 4));

        Staff updated = new Staff(id, name, role, dept, contact);
        controller.updateStaff(id, updated);
        loadData();
    }

    private void deleteStaff() {
        int selected = table.getSelectedRow();
        if (selected == -1) return;
        String id = tableModel.getValueAt(selected, 0).toString();
        controller.deleteStaff(id);
        loadData();
    }
}
