package healthcare.view;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import healthcare.controller.DataController;
import healthcare.model.Staff;
import java.awt.*;
import java.util.List;

public class StaffPanel extends JPanel {
    private JTable table;
    private DefaultTableModel model;
    private DataController controller;

    public StaffPanel(DataController controller) {
        this.controller = controller;
        setLayout(new BorderLayout());

        model = new DefaultTableModel(new String[]{"ID", "Name", "Role", "Department", "Contact"}, 0);
        table = new JTable(model);
        loadStaff();

        JPanel buttonPanel = new JPanel();
        JButton addBtn = new JButton("Add Staff");
        JButton editBtn = new JButton("Edit");
        JButton deleteBtn = new JButton("Delete");

        addBtn.addActionListener(e -> addStaff());
        editBtn.addActionListener(e -> editStaff());
        deleteBtn.addActionListener(e -> deleteStaff());

        buttonPanel.add(addBtn);
        buttonPanel.add(editBtn);
        buttonPanel.add(deleteBtn);

        add(new JScrollPane(table), BorderLayout.CENTER);
        add(buttonPanel, BorderLayout.SOUTH);
    }

    private void loadStaff() {
        model.setRowCount(0);
        List<Staff> staff = controller.getStaff();
        for (Staff s : staff) {
            model.addRow(new Object[]{s.getId(), s.getName(), s.getRole(), s.getDepartment(), s.getContact()});
        }
    }

    private void addStaff() {
        JTextField idField = new JTextField();
        JTextField nameField = new JTextField();
        JTextField roleField = new JTextField();
        JTextField departmentField = new JTextField();
        JTextField contactField = new JTextField();

        Object[] fields = {"ID:", idField, "Name:", nameField, "Role:", roleField,
                "Department:", departmentField, "Contact:", contactField};

        int option = JOptionPane.showConfirmDialog(this, fields, "Add Staff", JOptionPane.OK_CANCEL_OPTION);
        if (option == JOptionPane.OK_OPTION) {
            Staff s = new Staff(idField.getText(), nameField.getText(), roleField.getText(),
                    departmentField.getText(), contactField.getText());
            controller.addStaff(s);
            loadStaff();
        }
    }

    private void editStaff() {
        int row = table.getSelectedRow();
        if (row == -1) return;

        JTextField idField = new JTextField(model.getValueAt(row, 0).toString());
        JTextField nameField = new JTextField(model.getValueAt(row, 1).toString());
        JTextField roleField = new JTextField(model.getValueAt(row, 2).toString());
        JTextField departmentField = new JTextField(model.getValueAt(row, 3).toString());
        JTextField contactField = new JTextField(model.getValueAt(row, 4).toString());

        Object[] fields = {"ID:", idField, "Name:", nameField, "Role:", roleField,
                "Department:", departmentField, "Contact:", contactField};

        int option = JOptionPane.showConfirmDialog(this, fields, "Edit Staff", JOptionPane.OK_CANCEL_OPTION);
        if (option == JOptionPane.OK_OPTION) {
            Staff updated = new Staff(idField.getText(), nameField.getText(), roleField.getText(),
                    departmentField.getText(), contactField.getText());
            controller.getStaff().set(row, updated);
            controller.saveStaff();
            loadStaff();
        }
    }

    private void deleteStaff() {
        int row = table.getSelectedRow();
        if (row == -1) return;
        controller.getStaff().remove(row);
        controller.saveStaff();
        loadStaff();
    }
}
