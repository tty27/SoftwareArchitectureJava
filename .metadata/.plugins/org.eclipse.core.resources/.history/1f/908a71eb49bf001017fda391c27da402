package healthcare.view;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import healthcare.controller.DataController;
import healthcare.model.Referral;
import java.awt.*;
import java.util.List;

public class ReferralPanel extends JPanel {
    private JTable table;
    private DefaultTableModel model;
    private DataController controller;

    public ReferralPanel(DataController controller) {
        this.controller = controller;
        setLayout(new BorderLayout());

        model = new DefaultTableModel(new String[]{"ID", "Patient ID", "Clinician ID", "Summary", "Urgency"}, 0);
        table = new JTable(model);
        loadReferrals();

        JPanel buttonPanel = new JPanel();
        JButton addBtn = new JButton("Add Referral");
        JButton editBtn = new JButton("Edit");
        JButton deleteBtn = new JButton("Delete");

        addBtn.addActionListener(e -> addReferral());
        editBtn.addActionListener(e -> editReferral());
        deleteBtn.addActionListener(e -> deleteReferral());

        buttonPanel.add(addBtn);
        buttonPanel.add(editBtn);
        buttonPanel.add(deleteBtn);

        add(new JScrollPane(table), BorderLayout.CENTER);
        add(buttonPanel, BorderLayout.SOUTH);
    }

    private void loadReferrals() {
        model.setRowCount(0);
        List<Referral> referrals = controller.getReferrals();
        for (Referral r : referrals) {
            model.addRow(new Object[]{r.getId(), r.getPatientId(), r.getClinicianId(), r.getSummary(), r.getUrgencyLevel()});
        }
    }

    private void addReferral() {
        JTextField idField = new JTextField();
        JTextField patientIdField = new JTextField();
        JTextField clinicianIdField = new JTextField();
        JTextField summaryField = new JTextField();
        JTextField urgencyField = new JTextField();

        Object[] fields = {"ID:", idField, "Patient ID:", patientIdField, "Clinician ID:", clinicianIdField,
                "Summary:", summaryField, "Urgency:", urgencyField};

        int option = JOptionPane.showConfirmDialog(this, fields, "Add Referral", JOptionPane.OK_CANCEL_OPTION);
        if (option == JOptionPane.OK_OPTION) {
            Referral r = new Referral(idField.getText(), patientIdField.getText(),
                    clinicianIdField.getText(), summaryField.getText(), urgencyField.getText());
            controller.addReferral(r);
            loadReferrals();
        }
    }

    private void editReferral() {
        int row = table.getSelectedRow();
        if (row == -1) return;

        JTextField idField = new JTextField(model.getValueAt(row, 0).toString());
        JTextField patientIdField = new JTextField(model.getValueAt(row, 1).toString());
        JTextField clinicianIdField = new JTextField(model.getValueAt(row, 2).toString());
        JTextField summaryField = new JTextField(model.getValueAt(row, 3).toString());
        JTextField urgencyField = new JTextField(model.getValueAt(row, 4).toString());

        Object[] fields = {"ID:", idField, "Patient ID:", patientIdField, "Clinician ID:", clinicianIdField,
                "Summary:", summaryField, "Urgency:", urgencyField};

        int option = JOptionPane.showConfirmDialog(this, fields, "Edit Referral", JOptionPane.OK_CANCEL_OPTION);
        if (option == JOptionPane.OK_OPTION) {
            Referral updated = new Referral(idField.getText(), patientIdField.getText(),
                    clinicianIdField.getText(), summaryField.getText(), urgencyField.getText());
            controller.getReferrals().set(row, updated);
            controller.saveReferrals();
            loadReferrals();
        }
    }

    private void deleteReferral() {
        int row = table.getSelectedRow();
        if (row == -1) return;
        controller.getReferrals().remove(row);
        controller.saveReferrals();
        loadReferrals();
    }
}
