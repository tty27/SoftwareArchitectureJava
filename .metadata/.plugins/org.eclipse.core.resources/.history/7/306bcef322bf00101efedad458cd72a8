package healthcare.view;

import javax.swing.*;
import java.awt.*;
import healthcare.controller.*;

public class MainFrame extends JFrame {
    private DataController dataController = new DataController();

    public MainFrame() {
        setTitle("Healthcare Management System");
        setSize(800, 600);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout());

        JLabel title = new JLabel("Healthcare Management System", SwingConstants.CENTER);
        add(title, BorderLayout.NORTH);

        JButton patientBtn = new JButton("View Patients");
        JButton clinicianBtn = new JButton("View Clinicians");
        JButton appointmentBtn = new JButton("Appointments");
        JButton prescriptionBtn = new JButton("Prescriptions");

        JPanel panel = new JPanel(new GridLayout(2, 2, 10, 10));
        panel.add(patientBtn);
        panel.add(clinicianBtn);
        panel.add(appointmentBtn);
        panel.add(prescriptionBtn);

        add(panel, BorderLayout.CENTER);

        setVisible(true);
    }
}
