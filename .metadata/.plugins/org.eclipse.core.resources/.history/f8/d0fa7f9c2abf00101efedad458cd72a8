package healthcare.controller;

import healthcare.model.Patient;
import healthcare.model.Clinician;
import healthcare.model.Appointment;
import healthcare.model.Prescription;

import java.io.*;
import java.nio.file.*;
import java.util.*;

public class DataController {
    private List<Patient> patients = new ArrayList<>();
    private List<Clinician> clinicians = new ArrayList<>();
    private List<Appointment> appointments = new ArrayList<>();
    private List<Prescription> prescriptions = new ArrayList<>();

    private final String dataDir = "data"; // ensure this folder exists in project root
    private final String patientsFile = dataDir + "/patients.csv";

    public DataController() {
        // load CSVs at startup
        loadPatientsFromCSV();
        // TODO: call other loaders (clinicians, appointments...).
    }

    // Patients CRUD
    public void addPatient(Patient p) {
        patients.add(p);
        savePatientsToCSV(); // persist change
    }

    public void updatePatient(Patient updated) {
        // find by id and replace fields
        for (int i = 0; i < patients.size(); i++) {
            if (patients.get(i).getId().equals(updated.getId())) {
                patients.set(i, updated);
                break;
            }
        }
        savePatientsToCSV();
    }

    public void removePatientById(String id) {
        patients.removeIf(p -> p.getId().equals(id));
        savePatientsToCSV();
    }

    public List<Patient> getPatients() {
        return patients;
    }

    // CSV load/save (simple implementation, assumes no commas inside fields)
    private void loadPatientsFromCSV() {
        patients.clear();
        Path path = Paths.get(patientsFile);
        if (!Files.exists(path)) return; // nothing to load yet

        try (BufferedReader br = Files.newBufferedReader(path)) {
            String line;
            // optional: if first line is header, skip it
            boolean first = true;
            while ((line = br.readLine()) != null) {
                if (first && line.toLowerCase().contains("id,")) { first = false; continue; }
                String[] cols = line.split(",", -1);
                // adjust indexes to match your CSV structure
                // Example CSV columns: id,name,email,nhs,address,phone
                if (cols.length >= 6) {
                    Patient p = new Patient(cols[0].trim(), cols[1].trim(), cols[2].trim(),
                                            cols[3].trim(), cols[4].trim(), cols[5].trim());
                    patients.add(p);
                }
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    private void savePatientsToCSV() {
        Path path = Paths.get(patientsFile);
        try {
            Files.createDirectories(path.getParent());
        } catch (IOException e) {
            e.printStackTrace();
        }

        try (BufferedWriter bw = Files.newBufferedWriter(path)) {
            // write header
            bw.write("id,name,email,nhs,address,phone");
            bw.newLine();
            for (Patient p : patients) {
                // escape commas if needed (not implemented here)
                String line = String.join(",",
                        safe(p.getId()),
                        safe(p.getName()),
                        safe(p.getEmail()),
                        safe(p.getNhsNumber()),
                        safe(p.getAddress()),
                        safe(p.getPhone())
                );
                bw.write(line);
                bw.newLine();
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    private String safe(String s) {
        return s == null ? "" : s.replace(",", " "); // crude but avoids breaking CSV structure
    }

    // TODO: similar load/save methods for Clinician/Appointment/Prescription
}
