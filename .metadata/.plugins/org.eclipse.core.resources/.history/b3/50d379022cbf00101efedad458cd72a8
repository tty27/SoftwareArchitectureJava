package healthcare.model;

import java.io.FileWriter;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

public class Referral {
    private static Referral instance;
    private List<String> referralLogs = new ArrayList<>();

    private Referral() {}

    public static Referral getInstance() {
        if (instance == null) {
            instance = new Referral();
        }
        return instance;
    }

    public void createReferral(String patientId, String clinicianId, String summary, String urgency) {
        String record = patientId + "," + clinicianId + "," + summary + "," + urgency;
        referralLogs.add(record);
        saveToFile(record);
    }

    private void saveToFile(String record) {
        try (FileWriter fw = new FileWriter("referrals_generated.txt", true)) {
            fw.write(record + "\n");
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public List<String> getReferralLogs() {
        return referralLogs;
    }
}
