package healthcare.view;

import javax.swing.*;
import healthcare.controller.DataController;
import healthcare.model.Prescription;

public class PrescriptionPanel extends BasePanel<Prescription> {
    private DataController controller;

    public PrescriptionPanel(DataController controller) {
        super(new String[]{"ID", "Patient ID", "Medication", "Dosage"});
        this.controller = controller;

        setAddAction(e -> addPrescription());
        setEditAction(e -> editPrescription());
        setDeleteAction(e -> deletePrescription());
    }

    private void addPrescription() {
        JTextField id = new JTextField(), pid = new JTextField(), med = new JTextField(), dose = new JTextField();
        Object[] fields = {"ID:", id, "Patient ID:", pid, "Medication:", med, "Dosage:", dose};
        if (JOptionPane.showConfirmDialog(this, fields, "Add Prescription", JOptionPane.OK_CANCEL_OPTION) == JOptionPane.OK_OPTION) {
            Prescription p = new Prescription(id.getText(), pid.getText(), med.getText(), dose.getText());
            controller.addPrescription(p);
            model.addRow(new Object[]{p.getId(), p.getPatientId(), p.getMedication(), p.getDosage()});
        }
    }

    private void editPrescription() {
        int row = getSelectedRow();
        if (row == -1) { JOptionPane.showMessageDialog(this, "Select a row first."); return; }

        JTextField id = new JTextField((String) model.getValueAt(row, 0));
        JTextField pid = new JTextField((String) model.getValueAt(row, 1));
        JTextField med = new JTextField((String) model.getValueAt(row, 2));
        JTextField dose = new JTextField((String) model.getValueAt(row, 3));

        Object[] fields = {"ID:", id, "Patient ID:", pid, "Medication:", med, "Dosage:", dose};
        if (JOptionPane.showConfirmDialog(this, fields, "Edit Prescription", JOptionPane.OK_CANCEL_OPTION) == JOptionPane.OK_OPTION) {
            model.setValueAt(id.getText(), row, 0);
            model.setValueAt(pid.getText(), row, 1);
            model.setValueAt(med.getText(), row, 2);
            model.setValueAt(dose.getText(), row, 3);
        }
    }

    private void deletePrescription() {
        int row = getSelectedRow();
        if (row >= 0) removeRow(row);
    }
}
