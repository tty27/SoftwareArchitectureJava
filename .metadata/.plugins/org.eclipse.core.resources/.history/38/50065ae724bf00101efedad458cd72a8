package healthcare.view;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import healthcare.controller.DataController;
import healthcare.model.Patient;

public class PatientPanel extends JFrame {
    private DefaultTableModel model;

    public PatientPanel(DataController controller) {
        setTitle("Patients");
        setSize(600, 400);
        setLayout(new BorderLayout());

        String[] columns = {"ID", "Name", "Email", "NHS", "Address", "Phone"};
        model = new DefaultTableModel(columns, 0);
        JTable table = new JTable(model);
        add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel panel = new JPanel();
        JButton addBtn = new JButton("Add");
        JButton delBtn = new JButton("Delete");
        panel.add(addBtn);
        panel.add(delBtn);
        add(panel, BorderLayout.SOUTH);

        addBtn.addActionListener(e -> {
            JTextField id = new JTextField();
            JTextField name = new JTextField();
            JTextField email = new JTextField();
            JTextField nhs = new JTextField();
            JTextField address = new JTextField();
            JTextField phone = new JTextField();

            Object[] fields = {"ID:", id, "Name:", name, "Email:", email, "NHS:", nhs, "Address:", address, "Phone:", phone};
            int option = JOptionPane.showConfirmDialog(this, fields, "Add Patient", JOptionPane.OK_CANCEL_OPTION);
            if (option == JOptionPane.OK_OPTION) {
                Patient p = new Patient(id.getText(), name.getText(), email.getText(), nhs.getText(), address.getText(), phone.getText());
                controller.addPatient(p);
                model.addRow(new Object[]{p.getId(), p.getName(), p.getEmail(), p.getNhsNumber(), p.getAddress(), p.getPhone()});
            }
        });

        delBtn.addActionListener(e -> {
            int row = table.getSelectedRow();
            if (row >= 0) model.removeRow(row);
        });

        setVisible(true);
    }
}
