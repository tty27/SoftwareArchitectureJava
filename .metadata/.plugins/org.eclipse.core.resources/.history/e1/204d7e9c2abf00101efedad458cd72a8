package healthcare.model;

public class Referral {
    private String referralId;
    private String patientId;
    private String fromDoctorId;
    private String toSpecialistId;
    private String reason;
    private String urgency;

    public Referral(String referralId, String patientId, String fromDoctorId, String toSpecialistId, String reason, String urgency) {
        this.referralId = referralId;
        this.patientId = patientId;
        this.fromDoctorId = fromDoctorId;
        this.toSpecialistId = toSpecialistId;
        this.reason = reason;
        this.urgency = urgency;
    }

    public String getReferralId() { return referralId; }
    public String getPatientId() { return patientId; }
    public String getFromDoctorId() { return fromDoctorId; }
    public String getToSpecialistId() { return toSpecialistId; }
    public String getReason() { return reason; }
    public String getUrgency() { return urgency; }
}
