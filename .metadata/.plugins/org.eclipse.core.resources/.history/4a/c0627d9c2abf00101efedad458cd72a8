package healthcare.controller;

import healthcare.model.Referral;
import healthcare.singleton.ReferralManager;

public class ReferralController {
    private ReferralManager referralManager = ReferralManager.getInstance();

    public void addReferral(Referral r) {
        referralManager.addReferral(r);
    }

    public void printReferralToFile(Referral r) {
        referralManager.generateReferralTextFile(r);
    }
}
