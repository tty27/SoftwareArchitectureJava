package healthcare.view;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import healthcare.controller.DataController;
import healthcare.model.Prescription;

public class PrescriptionPanel extends JFrame {
    public PrescriptionPanel(DataController controller) {
        setTitle("Prescriptions");
        setSize(600, 400);
        setLayout(new BorderLayout());

        String[] columns = {"ID", "Patient ID", "Medication", "Dosage"};
        DefaultTableModel model = new DefaultTableModel(columns, 0);
        JTable table = new JTable(model);
        add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel bottom = new JPanel();
        JButton add = new JButton("Add");
        JButton del = new JButton("Delete");
        bottom.add(add); bottom.add(del);
        add(bottom, BorderLayout.SOUTH);

        add.addActionListener(e -> {
            JTextField id = new JTextField(), pid = new JTextField(), med = new JTextField(), dose = new JTextField();
            Object[] fields = {"ID:", id, "Patient ID:", pid, "Medication:", med, "Dosage:", dose};
            int result = JOptionPane.showConfirmDialog(this, fields, "Add Prescription", JOptionPane.OK_CANCEL_OPTION);
            if (result == JOptionPane.OK_OPTION) {
                Prescription p = new Prescription(id.getText(), pid.getText(), med.getText(), dose.getText());
                controller.addPrescription(p);
                model.addRow(new Object[]{p.getId(), p.getPatientId(), p.getMedication(), p.getDosage()});
            }
        });

        del.addActionListener(e -> {
            int row = table.getSelectedRow();
            if (row >= 0) model.removeRow(row);
        });

        setVisible(true);
    }
}
