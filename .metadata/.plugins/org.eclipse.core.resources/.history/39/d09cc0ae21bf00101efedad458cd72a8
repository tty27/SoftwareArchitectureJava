package healthcare.singleton;

import healthcare.model.Referral;
import java.util.*;
import java.io.*;

public class ReferralManager {
    private static ReferralManager instance;
    private List<Referral> referrals;

    private ReferralManager() {
        referrals = new ArrayList<>();
    }

    public static ReferralManager getInstance() {
        if (instance == null) {
            instance = new ReferralManager();
        }
        return instance;
    }

    public void addReferral(Referral r) {
        referrals.add(r);
    }

    public List<Referral> getReferrals() {
        return referrals;
    }

    public void generateReferralTextFile(Referral r) {
        try (FileWriter writer = new FileWriter("referral_" + r.getReferralId() + ".txt")) {
            writer.write("Referral ID: " + r.getReferralId() + "\n");
            writer.write("Patient ID: " + r.getPatientId() + "\n");
            writer.write("From Doctor ID: " + r.getFromDoctorId() + "\n");
            writer.write("To Specialist ID: " + r.getToSpecialistId() + "\n");
            writer.write("Reason: " + r.getReason() + "\n");
            writer.write("Urgency: " + r.getUrgency() + "\n");
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
